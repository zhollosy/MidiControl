/* ═══════════════════════════════════════════
   Roland D-70 Super LA Synthesis — Stylesheet
   ═══════════════════════════════════════════ */

/* ── Surface root ── */
QMCSurfaceD70 {
    background-color: #3a3a3a;
    color: #d0d0d0;
}

/* ── Logo bar ── */
QMCSurfaceD70 > QLabel#logo_label {
    color: #d0d0d0;
    font: bold 14pt 'Arial';
    padding: 2px 8px;
}

QMCSurfaceD70 > QLabel#model_label {
    color: #d0d0d0;
    font: 11pt 'Consolas';
    padding: 2px 8px;
}

/* ── Group headers ── */
QMCGroup > QWidget#group_header {
    background-color: #1a1a1a;
    color: #d0d0d0;
    font: bold 8pt 'Consolas';
}

QMCGroup > QWidget#group_content {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0.0 #909090, stop:0.15 #3a3a3a,
        stop:0.35 #2e2e2e, stop:0.65 #2e2e2e,
        stop:0.85 #111111, stop:1.0 #0a0a0a);
}

/* ── Button label ── */
QMCButton > QLabel#button_label {
    color: #d0d0d0;
    font: 8pt 'Consolas';
}

/* Button body/LED now custom-painted in _ButtonBody */

/* ── Sliders ── */
QMCSlider > QLabel {
    color: #d0d0d0;
}

QMCSlider > QLabel#value_label {
    font: 9pt 'Consolas';
}

QMCSlider > QLabel#name_label {
    font: 8pt 'Consolas';
}

/* Slider groove/handle now custom-painted in _CustomSlider */

/* ── Slider group labels ── */
QMCSliderGroup QLabel#name_label {
    color: #ffffff;
    font: 8pt 'Consolas';
}

/* ── Dial labels ── */
QMCDial > QLabel#value_label {
    color: #d0d0d0;
    font: 9pt 'Consolas';
}

QMCDial > QLabel#name_label {
    color: #d0d0d0;
    font: 8pt 'Consolas';
}

/* ── LCD display ── */
QFrame#lcd_display {
    background-color: #0a1a0a;
    border: 2px inset #333;
}

QFrame#lcd_display > QLabel {
    color: #33ff66;
    font: 16pt 'Consolas';
    background: transparent;
}

/* ── Keyboard ── */
QMCKeyboard {
    background-color: #2e2e2e;
}
